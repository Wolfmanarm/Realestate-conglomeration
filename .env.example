# Provided automatically on Railway when you reference the Postgres service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/realestate

# Secret used for the import/admin API (Authorization: Bearer <token>). Generate a long random value.
ADMIN_TOKEN=change-me

# Optional
# PORT=3000
# SEED_SAMPLE_DATA=true          # seed demo listings when the database is empty
# SEED_PER_CITY=8
# RATES_REFRESH_HOURS=6
# EXCHANGE_RATES_URL=https://open.er-api.com/v6/latest/USD
# PGSSL=false

# RESO Web API (MLS) importer: see README "Loading real listings"
# RESO_BASE_URL=https://api.yourmls.com/odata
# RESO_TOKEN=
# RESO_TOKEN_URL=
# RESO_CLIENT_ID=
# RESO_CLIENT_SECRET=
# RESO_SOURCE=my-mls
# RESO_CURRENCY=USD
# RESO_DEFAULT_COUNTRY=US
# RESO_EXTRA_FILTER=PropertyType eq 'Residential'
# RESO_EXPAND_MEDIA=false
# RESO_LISTING_URL_TEMPLATE=https://yourbrokerage.com/listing/{ListingKey}
# RESO_SYNC_MINUTES=60
# RESO_FULL_SYNC_HOURS=24
