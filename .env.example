# Provided automatically on Railway when you reference the Postgres service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/realestate

# Secret used for the import/admin API (Authorization: Bearer <token>). Generate a long random value.
ADMIN_TOKEN=change-me

# Optional
# PORT=3000
# SEED_SAMPLE_DATA=true          # seed demo listings when the database is empty
# SEED_PER_CITY=8
# RATES_REFRESH_HOURS=6
# EXCHANGE_RATES_URL=https://open.er-api.com/v6/latest/USD
# PGSSL=false
